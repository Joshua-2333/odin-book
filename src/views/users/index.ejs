<!-- src/views/users/index.ejs -->

<main class="users-page">
  <h1>All Users</h1>

  <!-- Flash messages -->
  <% if (success) { %>
    <div class="flash flash-success"><%= success %></div>
  <% } %>

  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <% if (users.length === 0) { %>
    <p>No users found.</p>
  <% } %>

  <section class="user-list">
    <% users.forEach(profileUser => { %>

      <div class="user-card">

        <!-- Avatar + Username -->
        <a href="/users/<%= profileUser.id %>" class="user-link">
          <img
            src="<%= profileUser.avatar || '/avatars/default.png' %>"
            alt="<%= profileUser.username %> avatar"
            class="avatar-small"
          >
          <span><%= profileUser.username %></span>
        </a>

        <!-- Follow / Unfollow button -->
        <% if (!currentUser.guest && currentUser.id !== profileUser.id) { %>
          <form action="/users/<%= profileUser.id %>/<%= profileUser.isFollowing ? 'unfollow' : 'follow' %>" method="POST">
            <button
              type="submit"
              class="<%= profileUser.isFollowing ? 'btn-secondary' : 'btn-primary' %>"
            >
              <%= profileUser.isFollowing ? 'Unfollow' : 'Follow' %>
            </button>
          </form>
        <% } %>

      </div>

    <% }) %>
  </section>
</main>

<script>
  // Auto-hide flash messages
  setTimeout(() => {
    document.querySelectorAll('.flash').forEach(el => {
      el.style.animation = "fadeOutFlash 0.8s forwards";
    });
  }, 4000);
</script>