<!-- src/views/users/followers.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= profileUser.username %> – Followers</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <!-- Hide nav to prevent double header -->
  <%- include("../partials/header", { hideNav: true, currentUser }) %>

  <main class="followers-page">
    <h1>Followers of <%= profileUser.username %></h1>

    <% if (followers.length === 0) { %>
      <p>No followers yet.</p>
    <% } %>

    <ul class="user-list">
      <% followers.forEach(follower => { %>
        <li class="user-card">
          <a href="/users/<%= follower.id %>">
            <img
              src="<%= follower.avatar || '/avatars/default.png' %>"
              alt="<%= follower.username %> avatar"
              class="avatar-small"
            >
            <span><%= follower.username %></span>
          </a>
        </li>
      <% }) %>
    </ul>

    <a href="/users/<%= profileUser.id %>">← Back to profile</a>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>