<!-- src/views/posts/post.ejs -->

<article class="post">

  <!-- Post Header -->
  <div class="post-header">

    <img
      src="<%= post.author.avatar || '/avatars/default.png' %>"
      class="avatar"
    >

    <a href="/users/<%= post.author.id %>" class="post-author">
      <strong><%= post.author.username %></strong>
    </a>

  </div>


  <!-- Post Content -->
  <div class="post-content">

    <% if (post.content) { %>
      <p><%= post.content %></p>
    <% } %>

    <% if (post.mediaUrl) { %>

      <% if (post.mediaUrl.includes("youtube.com")) { %>

        <iframe
          src="<%= post.mediaUrl %>"
          title="YouTube video"
          frameborder="0"
          allowfullscreen>
        </iframe>

      <% } else { %>

        <% const ext = post.mediaUrl.split('.').pop().toLowerCase(); %>

        <% if (["jpg","jpeg","png","gif","webp"].includes(ext)) { %>
          <img src="<%= post.mediaUrl %>" alt="post media">
        <% } %>

        <% if (["mp4","webm"].includes(ext)) { %>
          <video controls>
            <source src="<%= post.mediaUrl %>">
          </video>
        <% } %>

      <% } %>

    <% } %>

  </div>


  <!-- Post Meta -->
  <div class="post-meta">

    <span class="post-likes">
      ❤️ <%= post.likes.length %>
    </span>

  </div>


  <!-- Post Actions -->
  <% if (!currentUser.guest) { %>

    <div class="post-actions">

      <form action="/posts/<%= post.id %>/like" method="POST">
        <button type="submit" class="btn-secondary">Like</button>
      </form>

    </div>

  <% } %>


  <!-- Comments -->
  <section class="comments">

    <% if (post.comments && post.comments.length) { %>

      <% post.comments.forEach(comment => { %>

        <div class="comment">

          <img
            src="<%= comment.author.avatar || '/avatars/default.png' %>"
            class="avatar-small"
          >

          <strong>
            <a href="/users/<%= comment.author.id %>" class="comment-author">
              <%= comment.author.username %>
            </a>
          </strong>

          <span><%= comment.content %></span>

        </div>

      <% }) %>

    <% } %>


    <% if (!currentUser.guest) { %>

      <form action="/posts/<%= post.id %>/comments" method="POST" class="comment-form">

        <input
          type="text"
          name="content"
          placeholder="Add a comment..."
          required
        />

        <button type="submit" class="btn-secondary">
          Comment
        </button>

      </form>

    <% } %>

  </section>

</article>