<!-- src/views/posts/post.ejs -->

<article class="post">

  <!-- Post Header -->
  <div class="post-header">
    <img src="<%= post.author.avatar || '/avatars/default.png' %>" class="avatar" alt="<%= post.author.username %> avatar">
    <a href="/users/<%= post.author.id %>" class="post-author">
      <strong><%= post.author.username %></strong>
    </a>
  </div>

  <!-- Post Content -->
  <div class="post-content">
    <% if (post.content) { %>
      <p><%= post.content %></p>
    <% } %>

    <% if (post.mediaUrl) { %>
      <% 
        let youtubeId = '';
        let vimeoId = '';
        const ext = post.mediaUrl.split('.').pop().toLowerCase();

        if (post.mediaUrl.includes('youtube.com/embed/')) {
          youtubeId = post.mediaUrl.split('youtube.com/embed/')[1].split(/[?&]/)[0];
        } else if (post.mediaUrl.includes('youtu.be')) {
          youtubeId = post.mediaUrl.split('youtu.be/')[1].split(/[?&]/)[0];
        } else if (post.mediaUrl.includes('youtube.com')) {
          const urlParams = new URLSearchParams(post.mediaUrl.split('?')[1]);
          youtubeId = urlParams.get('v');
        }

        if (post.mediaUrl.includes('vimeo.com')) {
          vimeoId = post.mediaUrl.split('vimeo.com/')[1].split(/[?&]/)[0];
        }
      %>

      <% if (youtubeId) { %>
        <div class="video-wrapper" style="position: relative; width: 100%; padding-top: 56.25%; overflow: hidden; border-radius: 12px; margin-top: 0.5rem;">
          <iframe
            src="https://www.youtube.com/embed/<%= youtubeId %>"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            style="position:absolute;top:0;left:0;width:100%;height:100%;">
          </iframe>
        </div>

      <% } else if (vimeoId) { %>

        <div class="video-wrapper" style="position: relative; width: 100%; padding-top: 56.25%; overflow: hidden; border-radius: 12px; margin-top: 0.5rem;">
          <iframe
            src="https://player.vimeo.com/video/<%= vimeoId %>"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            style="position:absolute;top:0;left:0;width:100%;height:100%;">
          </iframe>
        </div>

      <% } else if (["mp4","webm"].includes(ext)) { %>

        <div class="video-wrapper" style="position: relative; width: 100%; padding-top: 56.25%; overflow: hidden; border-radius: 12px; margin-top: 0.5rem;">
          <video controls style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain;">
            <source src="<%= post.mediaUrl %>" type="video/<%= ext %>">
          </video>
        </div>

      <% } else if (["jpg","jpeg","png","gif","webp"].includes(ext)) { %>

        <img src="<%= post.mediaUrl %>" alt="post media"
          style="width:100%;border-radius:12px;object-fit:cover;margin-top:.5rem;">

      <% } else { %>

        <a href="<%= post.mediaUrl %>" target="_blank">View media</a>

      <% } %>
    <% } %>
  </div>

  <!-- Post Meta -->
  <div class="post-meta">

    <!-- ❤️ Like Button -->
    <% if (currentUser && currentUser.id) { %>
      <button
        type="button"
        class="like-btn <%= post.likes.some(l => l.toString() === currentUser.id.toString()) ? 'liked' : '' %>"
        data-post-id="<%= post.id %>"
        aria-pressed="<%= post.likes.some(l => l.toString() === currentUser.id.toString()) ? 'true' : 'false' %>"
      >
        ❤️ <span class="post-likes"><%= post.likes.length %></span>
      </button>
    <% } else { %>
      <span>❤️ <%= post.likes.length %></span>
    <% } %>

    <!-- 💬 Comments Toggle -->
    <button
      type="button"
      class="comment-toggle"
      aria-expanded="false"
      aria-controls="comments-<%= post.id %>"
    >
      💬 <%= post.comments.length %> Comments
    </button>

  </div>

  <!-- Comments Section -->
  <section class="comments" id="comments-<%= post.id %>">

    <div class="comment-list">
      <% if (post.comments && post.comments.length) { %>
        <% post.comments.forEach(comment => { %>
          <div class="comment">
            <img src="<%= comment.author.avatar || '/avatars/default.png' %>"
              class="avatar-small"
              alt="<%= comment.author.username %> avatar">

            <strong>
              <a href="/users/<%= comment.author.id %>">
                <%= comment.author.username %>
              </a>
            </strong>

            <span><%= comment.content %></span>
          </div>
        <% }) %>
      <% } %>
    </div>

    <% if (currentUser && currentUser.id) { %>
      <form class="comment-form" data-post-id="<%= post.id %>">
        <input type="text" name="content" placeholder="Add a comment..." required>
        <button type="submit">Comment</button>
      </form>
    <% } %>

  </section>

</article>