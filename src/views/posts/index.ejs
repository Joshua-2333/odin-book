<!-- src/views/posts/index.ejs -->

<h1 class="page-title">Posts</h1>

<!-- Flash messages -->
<% if (success) { %>
  <div class="flash flash-success"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<!-- Create Post -->
<% if (currentUser && !currentUser.guest) { %>
  <form action="/posts" method="POST" enctype="multipart/form-data" class="post-form">
    <textarea name="content" placeholder="What's on your mind?" required></textarea>

    <div class="media-upload">
      <label for="media" class="media-label">📷 Add Image / GIF / Video</label>
      <input type="file" id="media" name="media" accept="image/*,video/mp4,video/webm" />
    </div>

    <div id="media-preview"></div>

    <button type="submit" class="btn-primary">Post</button>
  </form>
<% } else { %>
  <p class="guest-note">
    Guests can read posts but must log in to post, comment, or like.
  </p>
<% } %>

<!-- Posts Feed -->
<section class="posts">
  <% posts.forEach(post => { %>
    <article class="post" tabindex="0">

      <%
        const rawContent = post.content || "";
        const urlRegex = /(https?:\/\/[^\s]+)/gi;
        const foundUrls = rawContent.match(urlRegex) || [];

        let detectedMediaUrl = post.mediaUrl || null;
        let detectedMediaType = post.mediaType || null;

        if (!detectedMediaUrl) {
          for (const url of foundUrls) {
            const lowerUrl = url.toLowerCase();

            if (
              lowerUrl.includes(".jpg") ||
              lowerUrl.includes(".jpeg") ||
              lowerUrl.includes(".png") ||
              lowerUrl.includes(".gif") ||
              lowerUrl.includes(".webp")
            ) {
              detectedMediaUrl = url;
              detectedMediaType = lowerUrl.includes(".gif") ? "GIF" : "IMAGE";
              break;
            }

            if (
              lowerUrl.includes(".mp4") ||
              lowerUrl.includes(".webm")
            ) {
              detectedMediaUrl = url;
              detectedMediaType = "VIDEO";
              break;
            }
          }
        }

        let cleanedContent = rawContent;
        if (detectedMediaUrl && rawContent.includes(detectedMediaUrl)) {
          cleanedContent = rawContent.replace(detectedMediaUrl, "").trim();
        }
      %>

      <!-- Post header -->
      <div class="post-header">
        <img src="<%= post.author?.avatar || '/avatars/default.png' %>" class="avatar" alt="<%= post.author?.username || 'Unknown' %> avatar">
        <a href="/users/<%= post.author?.id || '#' %>" class="post-author">
          <strong><%= post.author?.username || 'Unknown' %></strong>
        </a>
      </div>

      <!-- Post text -->
      <% if (cleanedContent) { %>
        <p class="post-content"><%= cleanedContent %></p>
      <% } %>

      <!-- Post media -->
      <% if (detectedMediaUrl) { %>
        <%
          let youtubeId = '';
          let vimeoId = '';
          const ext = detectedMediaUrl.split('.').pop().toLowerCase().split('?')[0].split('#')[0];

          if (detectedMediaUrl.includes('youtube.com/embed/')) {
            youtubeId = detectedMediaUrl.split('youtube.com/embed/')[1].split(/[?&]/)[0];
          } else if (detectedMediaUrl.includes('youtu.be')) {
            youtubeId = detectedMediaUrl.split('youtu.be/')[1].split(/[?&]/)[0];
          } else if (detectedMediaUrl.includes('youtube.com')) {
            const parts = detectedMediaUrl.split('?');
            if (parts[1]) {
              const urlParams = new URLSearchParams(parts[1]);
              youtubeId = urlParams.get('v');
            }
          }

          if (detectedMediaUrl.includes('vimeo.com')) {
            vimeoId = detectedMediaUrl.split('vimeo.com/')[1].split(/[?&]/)[0];
          }
        %>

        <% if (youtubeId) { %>
          <iframe class="post-media" width="560" height="315"
            src="https://www.youtube.com/embed/<%= youtubeId %>"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>

        <% } else if (vimeoId) { %>
          <iframe class="post-media" width="560" height="315"
            src="https://player.vimeo.com/video/<%= vimeoId %>"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen></iframe>

        <% } else if (["mp4","webm"].includes(ext) || detectedMediaType === "VIDEO") { %>
          <video controls class="post-media">
            <source src="<%= detectedMediaUrl %>" type="video/<%= ext %>">
            Your browser does not support the video tag.
          </video>

        <% } else if (["jpg","jpeg","png","gif","webp"].includes(ext) || detectedMediaType === "IMAGE" || detectedMediaType === "GIF") { %>
          <img src="<%= detectedMediaUrl %>" class="post-media" alt="Post media">

        <% } else { %>
          <a href="<%= detectedMediaUrl %>" target="_blank">View media</a>
        <% } %>
      <% } %>

      <!-- Post Meta -->
      <div class="post-meta">
        <% if (currentUser && !currentUser.guest) { %>
          <button
            type="button"
            class="like-btn <%= post.likes.some(l => l.toString() === currentUser.id.toString()) ? 'liked' : '' %>"
            data-post-id="<%= post.id %>"
            aria-pressed="<%= post.likes.some(l => l.toString() === currentUser.id.toString()) ? 'true' : 'false' %>"
          >
            ❤️ <span class="post-likes"><%= post.likes.length %></span>
          </button>
        <% } else { %>
          <button type="button" disabled title="Log in to like posts">
            ❤️ <span class="post-likes"><%= post.likes.length %></span>
          </button>
        <% } %>

        <button
          type="button"
          class="comment-toggle"
          tabindex="0"
          aria-expanded="false"
          aria-controls="comments-<%= post.id %>"
        >
          💬 <%= post.comments.length %> Comments
        </button>
      </div>

      <!-- Comments Section -->
      <section class="comments" id="comments-<%= post.id %>">
        <div class="comment-list">
          <% post.comments.forEach(comment => { %>
            <div class="comment">
              <img src="<%= comment.author?.avatar || '/avatars/default.png' %>" class="avatar-small" alt="<%= comment.author?.username || 'Unknown' %> avatar">
              <strong class="comment-author">
                <a href="/users/<%= comment.author?.id || '#' %>"><%= comment.author?.username || 'Unknown' %></a>
              </strong>
              <span><%= comment.content %></span>
            </div>
          <% }) %>
        </div>

        <% if (currentUser && !currentUser.guest) { %>
          <form class="comment-form" data-post-id="<%= post.id %>">
            <input type="text" name="content" placeholder="Add a comment..." required>
            <button type="submit">Comment</button>
          </form>
        <% } %>
      </section>

    </article>
  <% }) %>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {

  // --- Likes Patch ---
  document.querySelectorAll('.like-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const postId = btn.dataset.postId;
      const likesCountSpan = btn.querySelector('.post-likes');

      if (!likesCountSpan) return;

      try {
        const res = await fetch(`/posts/${postId}/like`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        });

        const contentType = res.headers.get('content-type') || '';
        const isJson = contentType.includes('application/json');

        if (!isJson) {
          const text = await res.text();
          console.error('Unexpected non-JSON like response:', text);
          throw new Error('Server returned a non-JSON response.');
        }

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Failed to like/unlike post');
        }

        likesCountSpan.textContent = data.likesCount;
        btn.classList.toggle('liked', data.liked);
        btn.setAttribute('aria-pressed', data.liked);

      } catch (err) {
        console.error('Error liking post:', err);
      }
    });
  });

  // --- Toggle comments open/close ---
  document.querySelectorAll('.comment-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const targetId = toggle.getAttribute('aria-controls');
      const commentsSection = document.getElementById(targetId);
      if (!commentsSection) return;

      const isOpen = commentsSection.classList.toggle('open');
      toggle.setAttribute('aria-expanded', isOpen);
    });

    toggle.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle.click();
      }
    });
  });

  // --- Handle comment form submissions ---
  document.querySelectorAll('.comment-form').forEach(form => {
    form.addEventListener('submit', async e => {
      e.preventDefault();

      const postId = form.dataset.postId;
      const input = form.querySelector('input[name="content"]');
      const content = input.value.trim();
      if (!content) return;

      try {
        const res = await fetch(`/posts/${postId}/comments`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ content })
        });

        const contentType = res.headers.get('content-type') || '';
        const isJson = contentType.includes('application/json');

        if (!isJson) {
          const text = await res.text();
          console.error('Unexpected non-JSON comment response:', text);
          throw new Error('Server returned a non-JSON response.');
        }

        const comment = await res.json();

        if (!res.ok) {
          throw new Error(comment.error || 'Failed to post comment');
        }

        const commentList = form.closest('.comments').querySelector('.comment-list');

        const div = document.createElement('div');
        div.className = 'comment';
        div.innerHTML = `
          <img src="${comment.author.avatar || '/avatars/default.png'}" class="avatar-small" alt="${comment.author.username} avatar">
          <strong class="comment-author">
            <a href="/users/${comment.author.id}">${comment.author.username}</a>
          </strong>
          <span>${comment.content}</span>
        `;
        commentList.appendChild(div);
        input.value = '';

        const commentsSection = form.closest('.comments');
        if (!commentsSection.classList.contains('open')) {
          commentsSection.classList.add('open');
          const toggle = document.querySelector(`[aria-controls="${commentsSection.id}"]`);
          if (toggle) {
            toggle.setAttribute('aria-expanded', true);
          }
        }

        const toggle = document.querySelector(`[aria-controls="comments-${postId}"]`);
        if (toggle) {
          const match = toggle.textContent.match(/\d+/);
          const currentCount = match ? Number(match[0]) : 0;
          toggle.textContent = `💬 ${currentCount + 1} Comments`;
        }

      } catch (err) {
        console.error(err);
        alert(err.message || 'Error posting comment.');
      }
    });
  });

});
</script>