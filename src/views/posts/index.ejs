<!-- src/views/posts/index.ejs -->

<h1 class="page-title">Posts</h1>

<!-- Flash messages -->
<% if (success) { %>
  <div class="flash flash-success" id="flash-success">
    <%= success %>
  </div>
<% } %>

<% if (error) { %>
  <div class="flash flash-error" id="flash-error">
    <%= error %>
  </div>
<% } %>

<% if (!currentUser.guest) { %>
  <form action="/posts" method="POST" class="post-form">
    <textarea
      name="content"
      placeholder="What's on your mind?"
      required
    ></textarea>
    <button type="submit" class="btn-primary">Post</button>
  </form>
<% } else { %>
  <p class="guest-note">
    Guests can read posts but must log in to post, comment, or like.
  </p>
<% } %>

<section class="posts">
  <% posts.forEach(post => { %>
    <article class="post-card">
      <p class="post-content"><%= post.content %></p>

      <div class="post-meta">
        <span>
          by
          <a href="/users/<%= post.author.id %>" class="post-author">
            <strong><%= post.author.username %></strong>
          </a>
        </span>

        <span class="post-likes">❤️ <%= post.likes.length %></span>
      </div>

      <% if (!currentUser.guest) { %>
        <form action="/posts/<%= post.id %>/like" method="POST">
          <button type="submit" class="btn-secondary">Like</button>
        </form>
      <% } %>

      <!-- Comments -->
      <section class="comments">
        <% post.comments.forEach(comment => { %>
          <div class="comment">
            <strong>
              <a
                href="/users/<%= comment.author.id %>"
                class="comment-author"
              >
                <%= comment.author.username %>
              </a>:
            </strong>
            <span><%= comment.content %></span>
          </div>
        <% }) %>

        <% if (!currentUser.guest) { %>
          <form
            action="/posts/<%= post.id %>/comments"
            method="POST"
            class="comment-form"
          >
            <input
              type="text"
              name="content"
              placeholder="Add a comment..."
              required
            />
            <button type="submit" class="btn-secondary">
              Comment
            </button>
          </form>
        <% } %>
      </section>
    </article>
  <% }) %>
</section>
